APP_ENV=development
DATABASE_URL=sqlite:///./content_engine.db
OUTPUT_DIR=./output
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
FFMPEG_BINARY=ffmpeg
ALLOW_DEMO_FALLBACK=true
# Required for any externally reachable server. Use the same token in the Site.
ENGINE_API_TOKEN=

# Public HTTPS origin of this engine (no trailing path), and private Studio origin.
PUBLIC_ENGINE_URL=
STUDIO_URL=https://omid-content-studio.omidowski.chatgpt.site
# Fernet key; keep stable across deployments and backed up securely.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=v25.0
# Enable only on a persistent, single-process server. Automation itself starts paused.
PUBLISHING_WORKER_ENABLED=false
